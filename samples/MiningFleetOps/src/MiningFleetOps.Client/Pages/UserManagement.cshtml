@page
@model UserManagementModel
@{
    ViewData["Title"] = "Users & roles";
}

<section class="panel">
    <div class="resource-header">
        <div>
            <h1>Users & roles</h1>
            <p>Manage users, role membership, and generated permissions.</p>
        </div>
        <form method="post" asp-page-handler="Load">
            <button type="submit"><i class="fa-solid fa-rotate"></i><span>Load</span></button>
        </form>
    </div>
</section>

@if (Model.IsImpersonating)
{
    <section class="panel impersonation-panel">
        <div>
            <h2><i class="fa-solid fa-user-secret"></i><span>Impersonation active</span></h2>
            <p>You are signed in as @Model.CurrentUserName. Original admin: @Model.OriginalUserName.</p>
        </div>
        <form method="post" asp-page-handler="StopImpersonating">
            <button type="submit" class="button-secondary"><i class="fa-solid fa-arrow-right-from-bracket"></i><span>Return to admin</span></button>
        </form>
    </section>
}

@if (Model.ImpersonationEnabled)
{
    <form id="ImpersonateUserForm" method="post" asp-page-handler="ImpersonateUser" class="hidden-form">
        <input type="hidden" name="TargetUserId" id="ImpersonateTargetUserId" />
    </form>
}

<section class="panel">
    <div class="section-title">
        <h2><i class="fa-solid fa-chart-pie"></i><span>Access analytics</span></h2>
    </div>
    <div class="metric-grid">
        <div class="metric"><span>Users</span><strong id="metric-users">0</strong></div>
        <div class="metric"><span>Active users</span><strong id="metric-active-users">0</strong></div>
        <div class="metric"><span>Tenants</span><strong id="metric-tenants">0</strong></div>
        <div class="metric"><span>Roles</span><strong id="metric-roles">0</strong></div>
        <div class="metric"><span>Permissions</span><strong id="metric-permissions">0</strong></div>
        <div class="metric"><span>Assignments</span><strong id="metric-assignments">0</strong></div>
    </div>
    <div class="analytics-grid">
        <div class="analytics-card">
            <h3><i class="fa-solid fa-users-gear"></i><span>Users per role</span></h3>
            <div id="analytics-users-per-role" class="bar-list"></div>
        </div>
        <div class="analytics-card">
            <h3><i class="fa-solid fa-building"></i><span>Users per tenant</span></h3>
            <div id="analytics-users-per-tenant" class="bar-list"></div>
        </div>
        <div class="analytics-card">
            <h3><i class="fa-solid fa-key"></i><span>Permissions per role</span></h3>
            <div id="analytics-permissions-per-role" class="bar-list"></div>
        </div>
        <div class="analytics-card">
            <h3><i class="fa-solid fa-user-lock"></i><span>Direct user permissions</span></h3>
            <div id="analytics-direct-permissions" class="bar-list"></div>
        </div>
    </div>
    <div class="analytics-table-grid">
        <div class="analytics-card">
            <h3><i class="fa-solid fa-sitemap"></i><span>Tenant ecosystem</span></h3>
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Tenant</th>
                            <th>Users</th>
                            <th>Active</th>
                            <th>Roles</th>
                            <th>Direct permissions</th>
                        </tr>
                    </thead>
                    <tbody id="analytics-tenant-rows"></tbody>
                </table>
            </div>
        </div>
        <div class="analytics-card">
            <h3><i class="fa-solid fa-address-book"></i><span>User access directory</span></h3>
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Tenant</th>
                            <th>Status</th>
                            <th>Roles</th>
                            <th>Direct permissions</th>
                        </tr>
                    </thead>
                    <tbody id="analytics-user-rows"></tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<div class="form-grid">
    <section class="panel">
        <div class="section-title"><h2><i class="fa-solid fa-user-plus"></i><span>Create user</span></h2></div>
        <form method="post" asp-page-handler="CreateUser" class="fields">
            <label><span>User name</span><input asp-for="UserName" /></label>
            <label><span>Password</span><input asp-for="Password" type="password" /></label>
            <label>
                <span>Tenant</span>
                <select asp-for="TenantId" id="CreateUserTenantId">
                    @foreach (var tenant in Model.TenantOptions)
                    {
                        <option value="@tenant.Value">@tenant.Label</option>
                    }
                </select>
            </label>
            <label>
                <span>Role</span>
                <select asp-for="Role">
                    @foreach (var role in Model.RoleOptions)
                    {
                        <option value="@role.Name">@role.Name</option>
                    }
                </select>
            </label>
            <button type="submit"><i class="fa-solid fa-floppy-disk"></i><span>Create user</span></button>
        </form>
    </section>

    <section class="panel">
        <div class="section-title"><h2><i class="fa-solid fa-user-shield"></i><span>User access</span></h2></div>
        <form method="post" asp-page-handler="SetUserRoles" class="fields">
            <label>
                <span>User</span>
                <select asp-for="TargetUserId" id="UserRolesTargetUserId" onchange="populateUserRoles(this.value)">
                    <option value="">Choose user</option>
                    @foreach (var user in Model.UserOptions)
                    {
                        <option value="@user.Id">@user.Label</option>
                    }
                </select>
            </label>
            <label>
                <span>Roles</span>
                <select asp-for="SelectedRoles" multiple size="5">
                    @foreach (var role in Model.RoleOptions)
                    {
                        <option value="@role.Name">@role.Name</option>
                    }
                </select>
            </label>
            <button type="submit"><i class="fa-solid fa-check"></i><span>Set roles</span></button>
        </form>
        @if (ApiCatalog.HasPermissionManagement)
        {
            <form method="post" asp-page-handler="SetUserPermissions" class="fields stacked-form">
                <label>
                <span>User</span>
                    <select asp-for="TargetUserId" id="UserPermissionsTargetUserId" onchange="populateUserPermissions(this.value)">
                        <option value="">Choose user</option>
                        @foreach (var user in Model.UserOptions)
                        {
                            <option value="@user.Id">@user.Label</option>
                        }
                    </select>
                </label>
                <label>
                    <span>Direct permissions</span>
                    <select asp-for="SelectedPermissions" multiple size="6">
                        @foreach (var permission in Model.PermissionOptions)
                        {
                            <option value="@permission.Name">@permission.Name</option>
                        }
                    </select>
                </label>
                <button type="button" class="button-secondary" onclick="openPermissionBuilder('SelectedPermissions')"><i class="fa-solid fa-table-cells-large"></i><span>Pick module permissions</span></button>
                <button type="submit"><i class="fa-solid fa-key"></i><span>Set permissions</span></button>
            </form>
        }
    </section>
</div>

<div class="form-grid">
    <section class="panel">
        <div class="section-title"><h2><i class="fa-solid fa-id-card-clip"></i><span>Roles</span></h2></div>
        <form method="post" asp-page-handler="CreateRole" class="fields">
            <label><span>Role name</span><input asp-for="RoleName" /></label>
            <button type="submit"><i class="fa-solid fa-plus"></i><span>Create role</span></button>
        </form>
        @if (ApiCatalog.HasPermissionManagement)
        {
            <form method="post" asp-page-handler="SetRolePermissions" class="fields stacked-form">
                <label>
                    <span>Role</span>
                    <select asp-for="TargetRoleId" id="RolePermissionsTargetRoleId" onchange="populateRolePermissions(this.value)">
                        <option value="">Choose role</option>
                        @foreach (var role in Model.RoleOptions)
                        {
                            <option value="@role.Id">@role.Name</option>
                        }
                    </select>
                </label>
                <label>
                    <span>Permissions</span>
                    <select asp-for="SelectedRolePermissions" multiple size="6">
                        @foreach (var permission in Model.PermissionOptions)
                        {
                            <option value="@permission.Name">@permission.Name</option>
                        }
                    </select>
                </label>
                <button type="button" class="button-secondary" onclick="openPermissionBuilder('SelectedRolePermissions')"><i class="fa-solid fa-table-cells-large"></i><span>Pick module permissions</span></button>
                <button type="submit"><i class="fa-solid fa-key"></i><span>Set role permissions</span></button>
            </form>
        }
        <pre>@Model.RolesJson</pre>
    </section>

    <section class="panel">
        <div class="section-title"><h2><i class="fa-solid fa-key"></i><span>Permissions</span></h2></div>
        @if (ApiCatalog.HasPermissionManagement)
        {
            <form method="post" asp-page-handler="CreatePermission" class="fields">
                <label><span>Permission name</span><input asp-for="PermissionName" /></label>
                <button type="submit"><i class="fa-solid fa-plus"></i><span>Create permission</span></button>
            </form>
            <pre>@Model.PermissionsJson</pre>
        }
        else
        {
            <p class="status">Enable advanced RBAC seed in CrudGenerator to generate permission tables and permission management endpoints.</p>
        }
    </section>
</div>

<section class="panel">
    <h2><i class="fa-solid fa-users"></i><span>Users</span></h2>
    <pre>@Model.UsersJson</pre>
</section>

@if (ApiCatalog.HasPermissionManagement)
{
    <dialog id="analytics-detail" class="permission-dialog">
        <div class="dialog-header">
            <div>
                <h2><i class="fa-solid fa-magnifying-glass-chart"></i><span id="analytics-detail-title">Details</span></h2>
                <p id="analytics-detail-summary"></p>
            </div>
            <button type="button" class="button-icon" onclick="closeAnalyticsDetail()" title="Close"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div id="analytics-detail-body" class="analytics-detail-body"></div>
        <div class="dialog-actions">
            <button type="button" class="button-secondary" onclick="closeAnalyticsDetail()"><i class="fa-solid fa-xmark"></i><span>Close</span></button>
        </div>
    </dialog>

    <dialog id="permission-builder" class="permission-dialog">
        <div class="dialog-header">
            <div>
                <h2><i class="fa-solid fa-shield-halved"></i><span>Module permissions</span></h2>
                <p>Select modules and actions to generate special permissions such as Customer:read.</p>
            </div>
            <button type="button" class="button-icon" onclick="closePermissionBuilder()" title="Close"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="permission-builder">
            <label>
                <span>Modules</span>
                <select id="permission-builder-resources" multiple size="12">
                    @foreach (var resource in ApiCatalog.Resources)
                    {
                        <option value="@resource.DisplayName">@resource.DisplayName</option>
                    }
                </select>
            </label>
            <fieldset>
                <legend>Actions</legend>
                <label><input type="checkbox" value="read" checked /> <span>Read</span></label>
                <label><input type="checkbox" value="write" /> <span>Write</span></label>
                <label><input type="checkbox" value="update" /> <span>Edit</span></label>
                <label><input type="checkbox" value="delete" /> <span>Delete</span></label>
            </fieldset>
        </div>
        <div class="dialog-actions">
            <button type="button" class="button-secondary" onclick="closePermissionBuilder()"><i class="fa-solid fa-xmark"></i><span>Cancel</span></button>
            <button type="button" onclick="applyPermissionBuilder()"><i class="fa-solid fa-check"></i><span>Add selected</span></button>
        </div>
    </dialog>

    <script>
        const userAccessData = @Html.Raw(Model.UsersJson.TrimStart().StartsWith("[") ? Model.UsersJson : "[]");
        const roleAccessData = @Html.Raw(Model.RolesJson.TrimStart().StartsWith("[") ? Model.RolesJson : "[]");
        const permissionAccessData = @Html.Raw(Model.PermissionsJson.TrimStart().StartsWith("[") ? Model.PermissionsJson : "[]");
        const impersonationEnabled = @Model.ImpersonationEnabled.ToString().ToLowerInvariant();
        let permissionBuilderTargetId = "";

        function readList(item, ...names) {
            for (const name of names) {
                const value = item && item[name];
                if (Array.isArray(value)) {
                    return value;
                }
            }

            return [];
        }

        function setSelectedValues(selectId, values) {
            const select = document.getElementById(selectId);
            if (!select) {
                return;
            }

            const normalized = new Set(values.map(value => String(value).toLowerCase()));
            for (const option of Array.from(select.options)) {
                option.selected = normalized.has(option.value.toLowerCase());
            }

            for (const value of values) {
                const text = String(value);
                if (!Array.from(select.options).some(option => option.value.toLowerCase() === text.toLowerCase())) {
                    const option = new Option(text, text);
                    option.selected = true;
                    select.add(option);
                }
            }
        }

        function findAccessRow(rows, id) {
            return rows.find(row => String(row.id ?? row.Id ?? "").toLowerCase() === String(id ?? "").toLowerCase());
        }

        function populateUserRoles(userId) {
            const user = findAccessRow(userAccessData, userId);
            setSelectedValues("SelectedRoles", user ? readList(user, "roles", "Roles") : []);
        }

        function populateUserPermissions(userId) {
            const user = findAccessRow(userAccessData, userId);
            setSelectedValues("SelectedPermissions", user ? readList(user, "directPermissions", "DirectPermissions") : []);
        }

        function populateRolePermissions(roleId) {
            const role = findAccessRow(roleAccessData, roleId);
            setSelectedValues("SelectedRolePermissions", role ? readList(role, "permissions", "Permissions") : []);
        }

        function getValue(item, ...names) {
            for (const name of names) {
                if (item && item[name] !== undefined && item[name] !== null) {
                    return item[name];
                }
            }

            return "";
        }

        function countBy(items, valueFactory) {
            const counts = new Map();
            for (const item of items) {
                const values = valueFactory(item);
                for (const value of Array.isArray(values) ? values : [values]) {
                    const key = String(value || "Unassigned").trim() || "Unassigned";
                    counts.set(key, (counts.get(key) || 0) + 1);
                }
            }

            return Array.from(counts.entries()).sort((left, right) => right[1] - left[1] || left[0].localeCompare(right[0]));
        }

        function renderMetric(id, value) {
            const element = document.getElementById(id);
            if (element) {
                element.textContent = value.toLocaleString();
                element.closest(".metric")?.setAttribute("data-clickable", "true");
            }
        }

        function renderBars(id, rows, detailKind) {
            const target = document.getElementById(id);
            if (!target) {
                return;
            }

            target.innerHTML = "";
            if (rows.length === 0) {
                target.innerHTML = '<p class="status">No data available.</p>';
                return;
            }

            const max = Math.max(...rows.map(row => row[1]), 1);
            for (const [label, count] of rows.slice(0, 12)) {
                const row = document.createElement("div");
                row.className = "bar-row";
                row.tabIndex = 0;
                row.setAttribute("role", "button");
                row.addEventListener("click", () => openAnalyticsDetail(detailKind, label));
                row.addEventListener("keydown", event => {
                    if (event.key === "Enter" || event.key === " ") {
                        event.preventDefault();
                        openAnalyticsDetail(detailKind, label);
                    }
                });
                const labelRow = document.createElement("div");
                labelRow.className = "bar-row-label";
                const labelElement = document.createElement("span");
                labelElement.textContent = label;
                const countElement = document.createElement("strong");
                countElement.textContent = count.toLocaleString();
                labelRow.append(labelElement, countElement);
                const track = document.createElement("div");
                track.className = "bar-track";
                const fill = document.createElement("div");
                fill.className = "bar-fill";
                fill.style.width = `${Math.max(6, (count / max) * 100)}%`;
                track.appendChild(fill);
                row.append(labelRow, track);
                target.appendChild(row);
            }
        }

        function escapeHtml(value) {
            return String(value ?? "").replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;");
        }

        function escapeJs(value) {
            return JSON.stringify(String(value ?? ""));
        }

        function joinBadgeList(values) {
            if (!values || values.length === 0) {
                return '<span class="status">None</span>';
            }

            return values.map(value => `<span class="mini-badge">${escapeHtml(value)}</span>`).join("");
        }

        function renderAccessTables() {
            const tenantRows = document.getElementById("analytics-tenant-rows");
            const userRows = document.getElementById("analytics-user-rows");
            if (!tenantRows || !userRows) {
                return;
            }

            const tenants = new Map();
            for (const user of userAccessData) {
                const tenantName = String(getValue(user, "tenantName", "TenantName") || getValue(user, "tenantId", "TenantId") || "Unassigned");
                const row = tenants.get(tenantName) || { users: 0, active: 0, roles: new Set(), permissions: 0 };
                row.users++;
                if (String(getValue(user, "isEnabled", "IsEnabled")).toLowerCase() !== "false") {
                    row.active++;
                }
                for (const role of readList(user, "roles", "Roles")) {
                    row.roles.add(role);
                }
                row.permissions += readList(user, "directPermissions", "DirectPermissions").length;
                tenants.set(tenantName, row);
            }

            tenantRows.innerHTML = "";
            for (const [tenantName, row] of Array.from(tenants.entries()).sort((left, right) => right[1].users - left[1].users || left[0].localeCompare(right[0]))) {
                const tr = document.createElement("tr");
                tr.className = "clickable-row";
                tr.addEventListener("click", () => openAnalyticsDetail("tenant", tenantName));
                tr.innerHTML = `<td>${escapeHtml(tenantName)}</td><td>${row.users}</td><td>${row.active}</td><td>${row.roles.size}</td><td>${row.permissions}</td>`;
                tenantRows.appendChild(tr);
            }

            userRows.innerHTML = "";
            for (const user of [...userAccessData].sort((left, right) => String(getValue(left, "tenantName", "TenantName")).localeCompare(String(getValue(right, "tenantName", "TenantName"))) || String(getValue(left, "userName", "UserName")).localeCompare(String(getValue(right, "userName", "UserName"))))) {
                const active = String(getValue(user, "isEnabled", "IsEnabled")).toLowerCase() !== "false";
                const tr = document.createElement("tr");
                tr.className = "clickable-row";
                tr.addEventListener("click", () => openAnalyticsDetail("user", getValue(user, "id", "Id")));
                tr.innerHTML = `<td>${escapeHtml(getValue(user, "userName", "UserName"))}</td><td>${escapeHtml(getValue(user, "tenantName", "TenantName") || getValue(user, "tenantId", "TenantId"))}</td><td><span class="mini-badge ${active ? "success" : "muted"}">${active ? "Active" : "Disabled"}</span></td><td>${joinBadgeList(readList(user, "roles", "Roles"))}</td><td>${joinBadgeList(readList(user, "directPermissions", "DirectPermissions"))}</td>`;
                userRows.appendChild(tr);
            }
        }

        function renderDetailTable(rows, columns) {
            if (rows.length === 0) {
                return '<p class="status">No matching records.</p>';
            }

            const header = columns.map(column => `<th>${escapeHtml(column.label)}</th>`).join("");
            const body = rows.map(row => `<tr>${columns.map(column => `<td>${column.render(row)}</td>`).join("")}</tr>`).join("");
            return `<div class="table-wrap detail-table"><table class="data-table"><thead><tr>${header}</tr></thead><tbody>${body}</tbody></table></div>`;
        }

        function showAnalyticsDialog(dialog) {
            if (!dialog.open) {
                dialog.showModal();
            }
        }

        function userColumns() {
            return [
                { label: "User", render: user => escapeHtml(getValue(user, "userName", "UserName")) },
                { label: "Tenant", render: user => escapeHtml(getValue(user, "tenantName", "TenantName") || getValue(user, "tenantId", "TenantId")) },
                { label: "Status", render: user => String(getValue(user, "isEnabled", "IsEnabled")).toLowerCase() !== "false" ? '<span class="mini-badge success">Active</span>' : '<span class="mini-badge muted">Disabled</span>' },
                { label: "Roles", render: user => joinBadgeList(readList(user, "roles", "Roles")) },
                { label: "Direct permissions", render: user => joinBadgeList(readList(user, "directPermissions", "DirectPermissions")) },
                { label: "Command", render: user => `<div class="command-stack"><button type="button" class="button-secondary compact-button" data-command-stop="true" onclick='event.stopPropagation(); openUserEditor(${escapeJs(getValue(user, "id", "Id"))})'><i class="fa-solid fa-pen-to-square"></i><span>Manage</span></button>${impersonationEnabled ? `<button type="button" class="button-secondary compact-button" data-command-stop="true" onclick='event.stopPropagation(); impersonateUserFromAnalytics(${escapeJs(getValue(user, "id", "Id"))})'><i class="fa-solid fa-user-secret"></i><span>Impersonate</span></button>` : ""}</div>` }
            ];
        }

        function roleColumns() {
            return [
                { label: "Role", render: role => escapeHtml(getValue(role, "name", "Name")) },
                { label: "Permissions", render: role => joinBadgeList(readList(role, "permissions", "Permissions")) },
                { label: "Permission count", render: role => readList(role, "permissions", "Permissions").length.toLocaleString() },
                { label: "Command", render: role => `<button type="button" class="button-secondary compact-button" data-command-stop="true" onclick='event.stopPropagation(); openRoleEditor(${escapeJs(getValue(role, "id", "Id"))})'><i class="fa-solid fa-pen-to-square"></i><span>Manage</span></button>` }
            ];
        }

        function openAnalyticsDetail(kind, value) {
            const title = document.getElementById("analytics-detail-title");
            const summary = document.getElementById("analytics-detail-summary");
            const body = document.getElementById("analytics-detail-body");
            const dialog = document.getElementById("analytics-detail");
            if (!title || !summary || !body || !dialog) {
                return;
            }

            let rows = [];
            let columns = userColumns();
            let heading = "Details";
            let detail = "";

            if (kind === "all-users") {
                rows = [...userAccessData];
                heading = "All users";
                detail = `${rows.length} users across the ecosystem`;
            } else if (kind === "active-users") {
                rows = userAccessData.filter(user => String(getValue(user, "isEnabled", "IsEnabled")).toLowerCase() !== "false");
                heading = "Active users";
                detail = `${rows.length} active users`;
            } else if (kind === "tenant") {
                rows = userAccessData.filter(user => String(getValue(user, "tenantName", "TenantName") || getValue(user, "tenantId", "TenantId")) === String(value));
                heading = `Tenant: ${value}`;
                detail = `${rows.length} users in this tenant`;
            } else if (kind === "all-tenants") {
                const tenants = Array.from(new Set(userAccessData.map(user => String(getValue(user, "tenantName", "TenantName") || getValue(user, "tenantId", "TenantId") || "Unassigned")))).sort();
                rows = tenants.map(tenant => ({ name: tenant, users: userAccessData.filter(user => String(getValue(user, "tenantName", "TenantName") || getValue(user, "tenantId", "TenantId") || "Unassigned") === tenant) }));
                columns = [
                    { label: "Tenant", render: row => escapeHtml(row.name) },
                    { label: "Users", render: row => row.users.length.toLocaleString() },
                    { label: "Active", render: row => row.users.filter(user => String(getValue(user, "isEnabled", "IsEnabled")).toLowerCase() !== "false").length.toLocaleString() },
                    { label: "Roles", render: row => new Set(row.users.flatMap(user => readList(user, "roles", "Roles"))).size.toLocaleString() },
                    { label: "Command", render: row => `<button type="button" class="button-secondary compact-button" data-command-stop="true" onclick='event.stopPropagation(); manageTenantFromAnalytics(${escapeJs(row.name)})'><i class="fa-solid fa-user-plus"></i><span>Create user</span></button>` }
                ];
                heading = "All tenants";
                detail = `${rows.length} tenants`;
            } else if (kind === "role-users") {
                rows = userAccessData.filter(user => readList(user, "roles", "Roles").some(role => String(role).toLowerCase() === String(value).toLowerCase()));
                heading = `Role: ${value}`;
                detail = `${rows.length} users assigned to this role`;
            } else if (kind === "direct-permission-user") {
                rows = userAccessData.filter(user => String(getValue(user, "userName", "UserName")) === String(value));
                heading = `Direct permissions: ${value}`;
                detail = rows.length === 0 ? "No user found" : `${readList(rows[0], "directPermissions", "DirectPermissions").length} direct permissions`;
            } else if (kind === "role-permissions") {
                rows = roleAccessData.filter(role => String(getValue(role, "name", "Name")) === String(value));
                columns = roleColumns();
                heading = `Role permissions: ${value}`;
                detail = rows.length === 0 ? "No role found" : `${readList(rows[0], "permissions", "Permissions").length} permissions`;
            } else if (kind === "all-roles") {
                rows = [...roleAccessData];
                columns = roleColumns();
                heading = "All roles";
                detail = `${rows.length} roles`;
            } else if (kind === "all-permissions") {
                rows = [...permissionAccessData];
                columns = [{ label: "Permission", render: permission => escapeHtml(getValue(permission, "name", "Name")) }];
                heading = "All permissions";
                detail = `${rows.length} permissions`;
            } else if (kind === "user") {
                rows = userAccessData.filter(user => String(getValue(user, "id", "Id")).toLowerCase() === String(value).toLowerCase());
                heading = rows.length === 0 ? "User details" : `User: ${getValue(rows[0], "userName", "UserName")}`;
                detail = rows.length === 0 ? "No user found" : `Tenant: ${getValue(rows[0], "tenantName", "TenantName") || getValue(rows[0], "tenantId", "TenantId")}`;
            } else if (kind === "assignments") {
                rows = [...userAccessData];
                heading = "Access assignments";
                detail = "Roles and direct permissions by user";
            }

            title.textContent = heading;
            summary.textContent = detail;
            body.innerHTML = renderDetailTable(rows, columns);
            showAnalyticsDialog(dialog);
        }

        function verificationInput() {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";
            return token ? `<input type="hidden" name="__RequestVerificationToken" value="${escapeHtml(token)}" />` : "";
        }

        function optionsHtml(items, valueName, labelName, selectedValues) {
            const selected = new Set((selectedValues || []).map(value => String(value).toLowerCase()));
            return items.map(item => {
                const value = String(getValue(item, valueName, valueName[0].toUpperCase() + valueName.slice(1)));
                const label = String(getValue(item, labelName, labelName[0].toUpperCase() + labelName.slice(1)) || value);
                return `<option value="${escapeHtml(value)}" ${selected.has(value.toLowerCase()) ? "selected" : ""}>${escapeHtml(label)}</option>`;
            }).join("");
        }

        function openUserEditor(userId) {
            const user = findAccessRow(userAccessData, userId);
            if (!user) {
                return;
            }

            const title = document.getElementById("analytics-detail-title");
            const summary = document.getElementById("analytics-detail-summary");
            const body = document.getElementById("analytics-detail-body");
            const dialog = document.getElementById("analytics-detail");
            const active = String(getValue(user, "isEnabled", "IsEnabled")).toLowerCase() !== "false";
            title.textContent = `Manage user: ${getValue(user, "userName", "UserName")}`;
            summary.textContent = `Tenant: ${getValue(user, "tenantName", "TenantName") || getValue(user, "tenantId", "TenantId")}`;
            body.innerHTML = `
                <div class="modal-editor-grid">
                    <form method="post" action="?handler=SetUserRoles" class="modal-editor-card">
                        ${verificationInput()}
                        <input type="hidden" name="TargetUserId" value="${escapeHtml(userId)}" />
                        <h3><i class="fa-solid fa-users-gear"></i><span>Roles</span></h3>
                        <select name="SelectedRoles" multiple size="8">${optionsHtml(roleAccessData, "name", "name", readList(user, "roles", "Roles"))}</select>
                        <button type="submit"><i class="fa-solid fa-check"></i><span>Update roles</span></button>
                    </form>
                    <form method="post" action="?handler=SetUserPermissions" class="modal-editor-card">
                        ${verificationInput()}
                        <input type="hidden" name="TargetUserId" value="${escapeHtml(userId)}" />
                        <h3><i class="fa-solid fa-key"></i><span>Direct permissions</span></h3>
                        <select name="SelectedPermissions" multiple size="8">${optionsHtml(permissionAccessData, "name", "name", readList(user, "directPermissions", "DirectPermissions"))}</select>
                        <button type="submit"><i class="fa-solid fa-key"></i><span>Update permissions</span></button>
                    </form>
                    <form method="post" action="?handler=${active ? "DisableUser" : "EnableUser"}" class="modal-editor-card">
                        ${verificationInput()}
                        <input type="hidden" name="TargetUserId" value="${escapeHtml(userId)}" />
                        <h3><i class="fa-solid fa-toggle-${active ? "off" : "on"}"></i><span>Status</span></h3>
                        <p class="status">Current status: ${active ? "Active" : "Disabled"}</p>
                        <button type="submit" class="${active ? "button-danger" : ""}"><i class="fa-solid fa-${active ? "ban" : "circle-check"}"></i><span>${active ? "Disable user" : "Enable user"}</span></button>
                    </form>
                    ${impersonationEnabled ? `
                    <form method="post" action="?handler=ImpersonateUser" class="modal-editor-card">
                        ${verificationInput()}
                        <input type="hidden" name="TargetUserId" value="${escapeHtml(userId)}" />
                        <h3><i class="fa-solid fa-user-secret"></i><span>Impersonation</span></h3>
                        <p class="status">Open the client as this user while keeping your admin session available.</p>
                        <button type="submit"><i class="fa-solid fa-user-secret"></i><span>Impersonate user</span></button>
                    </form>` : ""}
                </div>`;
            showAnalyticsDialog(dialog);
        }

        function openRoleEditor(roleId) {
            const role = findAccessRow(roleAccessData, roleId);
            if (!role) {
                return;
            }

            const title = document.getElementById("analytics-detail-title");
            const summary = document.getElementById("analytics-detail-summary");
            const body = document.getElementById("analytics-detail-body");
            const dialog = document.getElementById("analytics-detail");
            title.textContent = `Manage role: ${getValue(role, "name", "Name")}`;
            summary.textContent = `${readList(role, "permissions", "Permissions").length} permissions`;
            body.innerHTML = `
                <form method="post" action="?handler=SetRolePermissions" class="modal-editor-card">
                    ${verificationInput()}
                    <input type="hidden" name="TargetRoleId" value="${escapeHtml(roleId)}" />
                    <h3><i class="fa-solid fa-key"></i><span>Role permissions</span></h3>
                    <select name="SelectedRolePermissions" multiple size="12">${optionsHtml(permissionAccessData, "name", "name", readList(role, "permissions", "Permissions"))}</select>
                    <button type="submit"><i class="fa-solid fa-check"></i><span>Update role permissions</span></button>
                </form>`;
            showAnalyticsDialog(dialog);
        }

        function closeAndScrollTo(element) {
            closeAnalyticsDetail();
            if (element) {
                element.scrollIntoView({ behavior: "smooth", block: "center" });
                element.focus?.();
            }
        }

        function manageUserFromAnalytics(userId) {
            const roleUser = document.getElementById("UserRolesTargetUserId");
            const permissionUser = document.getElementById("UserPermissionsTargetUserId");
            if (roleUser) {
                roleUser.value = userId;
                populateUserRoles(userId);
            }
            if (permissionUser) {
                permissionUser.value = userId;
                populateUserPermissions(userId);
            }
            closeAndScrollTo(roleUser || permissionUser);
        }

        function manageRoleFromAnalytics(roleId) {
            const role = document.getElementById("RolePermissionsTargetRoleId");
            if (role) {
                role.value = roleId;
                populateRolePermissions(roleId);
            }
            closeAndScrollTo(role);
        }

        function manageTenantFromAnalytics(tenantName) {
            const tenant = document.getElementById("CreateUserTenantId");
            if (tenant) {
                const option = Array.from(tenant.options).find(candidate => candidate.textContent.includes(tenantName) || candidate.value === tenantName);
                if (option) {
                    tenant.value = option.value;
                }
            }
            closeAndScrollTo(tenant);
        }

        function impersonateUserFromAnalytics(userId) {
            const form = document.getElementById("ImpersonateUserForm");
            const input = document.getElementById("ImpersonateTargetUserId");
            if (!form || !input) {
                return;
            }

            input.value = userId;
            form.submit();
        }

        function closeAnalyticsDetail() {
            const dialog = document.getElementById("analytics-detail");
            if (dialog) {
                dialog.close();
            }
        }

        function renderAccessAnalytics() {
            const tenantNames = new Set(userAccessData.map(user => String(getValue(user, "tenantName", "TenantName") || getValue(user, "tenantId", "TenantId"))).filter(Boolean));
            const roleAssignments = userAccessData.reduce((total, user) => total + readList(user, "roles", "Roles").length, 0);
            const directPermissionAssignments = userAccessData.reduce((total, user) => total + readList(user, "directPermissions", "DirectPermissions").length, 0);
            const rolePermissionAssignments = roleAccessData.reduce((total, role) => total + readList(role, "permissions", "Permissions").length, 0);

            renderMetric("metric-users", userAccessData.length);
            renderMetric("metric-active-users", userAccessData.filter(user => String(getValue(user, "isEnabled", "IsEnabled")).toLowerCase() !== "false").length);
            renderMetric("metric-tenants", tenantNames.size);
            renderMetric("metric-roles", roleAccessData.length);
            renderMetric("metric-permissions", permissionAccessData.length);
            renderMetric("metric-assignments", roleAssignments + directPermissionAssignments + rolePermissionAssignments);

            renderBars("analytics-users-per-role", countBy(userAccessData, user => readList(user, "roles", "Roles")), "role-users");
            renderBars("analytics-users-per-tenant", countBy(userAccessData, user => getValue(user, "tenantName", "TenantName") || getValue(user, "tenantId", "TenantId")), "tenant");
            renderBars("analytics-permissions-per-role", roleAccessData.map(role => [String(getValue(role, "name", "Name") || "Unnamed role"), readList(role, "permissions", "Permissions").length]).sort((left, right) => right[1] - left[1]), "role-permissions");
            renderBars("analytics-direct-permissions", userAccessData.map(user => [String(getValue(user, "userName", "UserName") || "Unnamed user"), readList(user, "directPermissions", "DirectPermissions").length]).sort((left, right) => right[1] - left[1]), "direct-permission-user");
            renderAccessTables();
        }

        function openPermissionBuilder(targetId) {
            permissionBuilderTargetId = targetId;
            const dialog = document.getElementById("permission-builder");
            if (dialog) {
                dialog.showModal();
            }
        }

        function closePermissionBuilder() {
            const dialog = document.getElementById("permission-builder");
            if (dialog) {
                dialog.close();
            }
        }

        function applyPermissionBuilder() {
            const target = document.getElementById(permissionBuilderTargetId);
            const resourceSelect = document.getElementById("permission-builder-resources");
            const actions = Array.from(document.querySelectorAll("#permission-builder input[type='checkbox']:checked")).map(input => input.value);
            if (!target || !resourceSelect || actions.length === 0) {
                return;
            }

            const resources = Array.from(resourceSelect.selectedOptions).map(option => option.value);
            for (const resource of resources) {
                for (const action of actions) {
                    const value = `${resource}:${action}`;
                    let option = Array.from(target.options).find(candidate => candidate.value.toLowerCase() === value.toLowerCase());
                    if (!option) {
                        option = new Option(value, value);
                        target.add(option);
                    }
                    option.selected = true;
                }
            }

            closePermissionBuilder();
        }

        document.addEventListener("DOMContentLoaded", () => {
            const roleUser = document.getElementById("UserRolesTargetUserId");
            const permissionUser = document.getElementById("UserPermissionsTargetUserId");
            const role = document.getElementById("RolePermissionsTargetRoleId");
            if (roleUser && roleUser.value) {
                populateUserRoles(roleUser.value);
            }
            if (permissionUser && permissionUser.value) {
                populateUserPermissions(permissionUser.value);
            }
            if (role && role.value) {
                populateRolePermissions(role.value);
            }
            document.getElementById("metric-users")?.closest(".metric")?.addEventListener("click", () => openAnalyticsDetail("all-users"));
            document.getElementById("metric-active-users")?.closest(".metric")?.addEventListener("click", () => openAnalyticsDetail("active-users"));
            document.getElementById("metric-tenants")?.closest(".metric")?.addEventListener("click", () => openAnalyticsDetail("all-tenants"));
            document.getElementById("metric-roles")?.closest(".metric")?.addEventListener("click", () => openAnalyticsDetail("all-roles"));
            document.getElementById("metric-permissions")?.closest(".metric")?.addEventListener("click", () => openAnalyticsDetail("all-permissions"));
            document.getElementById("metric-assignments")?.closest(".metric")?.addEventListener("click", () => openAnalyticsDetail("assignments"));
            renderAccessAnalytics();
        });
    </script>
}

<section class="panel">
    <h2>Response</h2>
    @if (Model.HasError)
    {
        <div class="alert">
            <strong><i class="fa-solid fa-triangle-exclamation"></i><span>@Model.ErrorMessage</span></strong>
            <details open><summary>View logs</summary><pre>@Model.ResponseBody</pre></details>
        </div>
    }
    else
    {
        <p class="status">HTTP @Model.LastStatusCode</p>
        <pre>@Model.ResponseBody</pre>
    }
</section>